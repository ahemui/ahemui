{
  "name": "ahemui",
  "version": "0.4.0",
  "description": "Point at anything in your running app and your coding agent gets the exact file and line to fix it. Vite plugin, local server and CLI for AhemUI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ahemui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@ahemui/cli": "0.1.0",
    "@ahemui/core": "0.1.0",
    "@ahemui/overlay": "0.1.0"
  },
  "license": "MIT",
  "homepage": "https://ahemui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahemui/ahemui.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/ahemui/ahemui/issues"
  },
  "keywords": [
    "vite-plugin",
    "vue",
    "react",
    "svelte",
    "coding-agent",
    "ai-agent",
    "claude-code",
    "codex",
    "mcp",
    "ui-feedback",
    "visual-feedback",
    "backlog"
  ],
  "engines": {
    "node": ">=20"
  }
}
