{
  "manifest_version": 3,
  "name": "AhemUI — visual feedback backlog",
  "version": "0.3.1",
  "description": "Highlight parts of any web app (local, staging or prod) and queue changes for Claude Code.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AhemUI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle capture mode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*",
        "https://localhost/*",
        "https://*.localhost/*",
        "https://*.test/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*",
        "https://localhost/*",
        "https://*.localhost/*",
        "https://*.test/*"
      ],
      "js": [
        "page-agent.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
